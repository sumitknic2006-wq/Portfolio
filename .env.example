# ==========================================
# Root Environment Variables Template
# Copy to .env or configure in respective subdirectories
# ==========================================

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_APP_NAME="Sumit Kumar Portfolio"
VITE_APP_ENV=development

# Backend Environment Variables
NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Database Configuration (Atlas in production / local URI in dev)
# Example local: mongodb://127.0.0.1:27017/sumit_portfolio
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sumit_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sumit_portfolio

# Optional Admin Credentials / Secret Keys (Future phases)
# JWT_SECRET=your_jwt_secret_change_in_production
# RESEND_API_KEY=your_resend_email_api_key_for_contact_form
