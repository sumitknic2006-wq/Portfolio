# ==============================================================================
# Sumit Kumar Portfolio - Backend Environment Configuration
# ==============================================================================

# Server Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=5001

# Primary Frontend URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional additional comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration (Optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# Phase 4 Planned Variables (Unused in Phase 3 standalone execution):
# ------------------------------------------------------------------------------
# MongoDB Connection String (Atlas in production / local MongoDB in dev)
# Unused in Phase 3; server operates in standalone mode with verified fixtures.
MONGODB_URI=mongodb://127.0.0.1:27017/sumit_portfolio

# Transactional Email API Key for Contact Form (e.g., Resend)
# Planned for Phase 4 live email delivery
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=sumitknic2006@gmail.com
