# ==============================================================================
# Sumit Kumar Portfolio - Backend Environment Configuration (Phase 4)
# ==============================================================================

# Server Environment Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=5001

# Primary Frontend URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional additional comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CONTACT_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# MongoDB Database Configuration (Phase 4)
# ------------------------------------------------------------------------------
# For Local Development:
# MONGODB_URI=mongodb://127.0.0.1:27017/sumit_portfolio
#
# For MongoDB Atlas Production:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/sumit_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sumit_portfolio

# Explicit Development Fixtures Fallback Flag:
# Set to 'true' ONLY in local development to allow dev fixture fallback when local MongoDB is not running.
# Strictly disallowed in production: production will fail fast or return 503 rather than silent fake data.
ALLOW_DEV_FIXTURES=false

# ------------------------------------------------------------------------------
# Phase 9: Admin Authentication & Dashboard Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (generate a 64+ char random hex string in prod)
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Default administrator credentials for setup script (run `npm run admin:setup`)
ADMIN_EMAIL=sumitknic2006@gmail.com
ADMIN_DEFAULT_PASSWORD=ChangeThisSecurePassword123!

# Frontend application public URL (used for generating links in emails)
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Phase 9: Transactional Email Notifications (Resend)
# ------------------------------------------------------------------------------
# Resend API key for instant email delivery upon visitor contact submission & replies
# Get your API key from https://resend.com
RESEND_API_KEY=
# Verified sender email address (e.g., onboarding@resend.dev or notifications@yourdomain.com)
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
# Target inbox address receiving visitor contact notifications
CONTACT_RECEIVER_EMAIL=sumitknic2006@gmail.com
ADMIN_EMAIL=sumitknic2006@gmail.com

# ------------------------------------------------------------------------------
# Phase 7: Real AI Portfolio Assistant Configuration
# ------------------------------------------------------------------------------
# Supported Providers: 'gemini' (default, official Google GenAI SDK) | 'openai' | 'mock'
AI_PROVIDER=gemini
# Secret Provider API Key (Keep strictly confidential in .env; never commit real credentials)
AI_API_KEY=
# Current Supported Model (e.g., gemini-2.5-flash, gemini-1.5-flash)
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_MS=12000
ASSISTANT_RATE_LIMIT_MAX=30

# ------------------------------------------------------------------------------
# DSA Explorer Coding Profiles Configuration
# ------------------------------------------------------------------------------
CODEFORCES_HANDLE=sumitknic567
LEETCODE_USERNAME=25001122
# Automatic background synchronization toggle and interval in minutes (e.g., 360 = 6 hours)
DSA_AUTO_SYNC_ENABLED=true
DSA_SYNC_INTERVAL_MINUTES=360
# Secret token for triggering external cron jobs via POST /api/v1/dsa/sync/cron
CRON_SECRET=super_secret_cron_api_key_for_dsa_sync
