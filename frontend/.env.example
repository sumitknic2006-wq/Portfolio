# ==============================================================================
# Sumit Kumar Developer Portfolio - Frontend Environment Configuration
# ==============================================================================

# Backend REST API Base URL
# For Local Development (adjust port to match backend PORT, default: 5001 or 5000):
VITE_API_BASE_URL=http://localhost:5001/api/v1

# For Production (Vercel / Cloud Edge deployment):
# Example: VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# Or:      VITE_API_BASE_URL=https://sumit-portfolio-api.onrender.com/api/v1

# Application Metadata (Public)
VITE_APP_NAME="Sumit Kumar | Developer Portfolio"
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# SECURITY NOTE:
# Frontend variables are public and bundled into the browser distribution.
# NEVER place MONGODB_URI, database passwords, or secret API keys in this file.
# Database credentials belong exclusively in backend/.env.
# ------------------------------------------------------------------------------
